            "train",
            "dev",
            "test"
          ],
          "title": "Source Split",
          "type": "string"
        },
        "source_image_id": {
          "minimum": 0,
          "title": "Source Image Id",
          "type": "integer"
        },
        "source_question_id": {
          "minimum": 0,
          "title": "Source Question Id",
          "type": "integer"
        },
        "source_row_index": {
          "minimum": 0,
          "title": "Source Row Index",
          "type": "integer"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "qid": {
          "minLength": 1,
          "title": "Qid",
          "type": "string"
        },
        "question_raw": {
          "minLength": 1,
          "title": "Question Raw",
          "type": "string"
        },
        "question_nfc": {
          "minLength": 1,
          "title": "Question Nfc",
          "type": "string"
        }
      },
      "required": [
        "archive_sha256",
        "source_split",
        "source_image_id",
        "source_question_id",
        "source_row_index",
        "filename",
        "document_id",
        "qid",
        "question_raw",
        "question_nfc"
      ],
      "title": "ReceiptQuestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "question": {
      "$ref": "#/$defs/ReceiptQuestion"
    },
    "duplicate_group_id": {
      "minLength": 1,
      "title": "Duplicate Group Id",
      "type": "string"
    },
    "image_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Image Sha256",
      "type": "string"
    }
  },
  "required": [
