{
  "$defs": {
    "PipelineBinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "student_bundle_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Student Bundle Sha256",
          "type": "string"
        },
        "student_protocol_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Student Protocol Sha256",
          "type": "string"
        },
        "filter_config_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Filter Config Sha256",
          "type": "string"
        },
        "fallback_profile_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fallback Profile Sha256",
          "type": "string"
        },
        "g4_evidence_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "G4 Evidence Sha256",
          "type": "string"
        },
        "fixture_only": {
          "title": "Fixture Only",
          "type": "boolean"
        }
      },
      "required": [
        "student_bundle_sha256",
        "student_protocol_sha256",
        "filter_config_sha256",
        "fallback_profile_sha256",
        "g4_evidence_sha256",
        "fixture_only"
      ],
      "title": "PipelineBinding",
      "type": "object"
    },
    "RoutingPolicy": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "protocol": {
          "const": "rule_routing_v1",
          "default": "rule_routing_v1",
          "title": "Protocol",
          "type": "string"
        },
        "min_local_score": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Local Score",
          "type": "number"
        },
        "request_timeout_seconds": {
          "default": 45,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Request Timeout Seconds",
          "type": "number"
        },
        "fallback_limit": {
          "const": 1,
          "default": 1,
          "title": "Fallback Limit",
          "type": "integer"
        },
        "transport_retries": {
          "const": 0,
          "default": 0,
          "title": "Transport Retries",
          "type": "integer"
        },
        "status": {
          "default": "candidate",
          "enum": [
            "candidate",
            "frozen_dev_calibrate"
          ],
          "title": "Status",
          "type": "string"
        },
        "verifier_profile_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Verifier Profile Sha256",
          "type": "string"
        },
        "implementation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Implementation Sha256",
          "type": "string"
        },
        "selection_evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Evidence Sha256"
        },
        "fixture_only": {
          "title": "Fixture Only",
          "type": "boolean"
        }
      },
      "required": [
        "verifier_profile_sha256",
        "implementation_sha256",
        "fixture_only"
      ],
      "title": "RoutingPolicy",
      "type": "object"
    },
    "VerifierConfig": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "protocol": {
          "const": "field_lexical_verifier_v1",
          "default": "field_lexical_verifier_v1",
          "title": "Protocol",
          "type": "string"
        },
        "text_threshold": {
          "default": 0.1,
          "enum": [
            0.0,
            0.05,
            0.1,
            0.15
          ],
          "title": "Text Threshold",
          "type": "number"
        },
        "min_text_length": {
          "default": 6,
          "maximum": 100,
          "minimum": 2,
          "title": "Min Text Length",
          "type": "integer"
        },
        "candidate_margin": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Candidate Margin",
          "type": "number"
        },
        "max_label_gap": {
          "default": 0.08,
          "exclusiveMinimum": 0,
          "maximum": 0.25,
          "title": "Max Label Gap",
          "type": "number"
        },
        "max_span_line_gap": {
          "default": 0.08,
          "exclusiveMinimum": 0,
          "maximum": 0.25,
          "title": "Max Span Line Gap",
          "type": "number"
        },
        "max_document_tokens": {
          "default": 4096,
          "maximum": 16384,
          "minimum": 1,
          "title": "Max Document Tokens",
          "type": "integer"
        },
        "max_span_tokens": {
          "default": 24,
          "maximum": 64,
          "minimum": 1,
          "title": "Max Span Tokens",
          "type": "integer"
        },
        "max_lines": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Lines",
          "type": "integer"
        },
        "max_answer_characters": {
          "default": 1024,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Answer Characters",
          "type": "integer"
        },
        "part_protocol": {
          "default": "whole_answer_v1",
          "enum": [
            "whole_answer_v1",
            "literal_separator_v1"
          ],
          "title": "Part Protocol",
          "type": "string"
        },
        "require_field_support": {
          "const": true,
          "default": true,
          "title": "Require Field Support",
          "type": "boolean"
        },
        "numeric_edits_allowed": {
          "const": false,
          "default": false,
          "title": "Numeric Edits Allowed",
          "type": "boolean"
        }
      },
      "title": "VerifierConfig",
      "type": "object"
    },
    "VerifierProfile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/VerifierConfig"
        },
        "binding": {
          "$ref": "#/$defs/PipelineBinding"
        },
        "access_plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Access Plan Sha256",
          "type": "string"
        },
        "implementation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Implementation Sha256",
          "type": "string"
        },
        "status": {
          "default": "candidate",
          "enum": [
            "candidate",
            "frozen_dev_select"
          ],
          "title": "Status",
          "type": "string"
        },
        "selection_evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Evidence Sha256"
        }
      },
      "required": [
        "config",
        "binding",
        "access_plan_sha256",
        "implementation_sha256"
      ],
      "title": "VerifierProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "protocol": {
      "const": "phase5_final_suite_plan_v1",
      "default": "phase5_final_suite_plan_v1",
      "title": "Protocol",
      "type": "string"
    },
    "verifier": {
      "$ref": "#/$defs/VerifierProfile"
    },
    "routing": {
      "$ref": "#/$defs/RoutingPolicy"
    },
    "frozen_access_plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Frozen Access Plan Sha256",
      "type": "string"
    },
    "test_image_ids": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "title": "Test Image Ids",
      "type": "array"
    },
    "ood_curation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Ood Curation Sha256",
      "type": "string"
    },
    "evaluator_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evaluator Source Sha256",
      "type": "string"
    },
    "systems": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Systems",
      "type": "object"
    },
    "primary_comparison": {
      "const": "P2_vs_P1-size",
      "default": "P2_vs_P1-size",
      "title": "Primary Comparison",
      "type": "string"
    },
    "additional_comparisons": {
      "default": [
        "P3-check_vs_P2",
        "P3-snap_vs_P3-check",
        "P4_vs_teacher-all"
      ],
      "items": {
        "enum": [
          "P3-check_vs_P2",
          "P3-snap_vs_P3-check",
          "P4_vs_teacher-all"
        ],
        "type": "string"
      },
      "title": "Additional Comparisons",
      "type": "array"
    },
    "fixture_only": {
      "title": "Fixture Only",
      "type": "boolean"
    },
    "execution_enabled": {
      "const": false,
      "default": false,
      "title": "Execution Enabled",
      "type": "boolean"
    },
    "g5_certified": {
      "const": false,
      "default": false,
      "title": "G5 Certified",
      "type": "boolean"
    }
  },
  "required": [
    "verifier",
    "routing",
    "frozen_access_plan_sha256",
    "test_image_ids",
    "ood_curation_sha256",
    "evaluator_source_sha256",
    "systems",
    "fixture_only"
  ],
  "title": "FinalSuitePlan",
  "type": "object"
}
