{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "reviewer_output_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Reviewer Output Sha256",
      "type": "string"
    },
    "final_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Final Record Sha256",
      "type": "string"
    },
    "decision": {
      "enum": [
        "confirmed_from_image",
        "corrected_from_image",
        "uncertain_excluded"
      ],
      "title": "Decision",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "adjudicator": {
      "const": "Codex assistant",
      "default": "Codex assistant",
      "title": "Adjudicator",
      "type": "string"
    },
    "human_verified": {
      "const": false,
      "default": false,
      "title": "Human Verified",
      "type": "boolean"
    }
  },
  "required": [
    "task_id",
    "reviewer_output_sha256",
    "final_record_sha256",
    "decision",
    "rationale"
  ],
  "title": "AIAdjudication",
  "type": "object"
}
