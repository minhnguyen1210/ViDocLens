{
  "$defs": {
    "TeacherProfile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "provider": {
          "const": "openai",
          "default": "openai",
          "title": "Provider",
          "type": "string"
        },
        "endpoint": {
          "const": "/v1/responses",
          "default": "/v1/responses",
          "title": "Endpoint",
          "type": "string"
        },
        "model_snapshot": {
          "pattern": "^gpt-[a-z0-9.\\-]+-\\d{4}-\\d{2}-\\d{2}$",
          "title": "Model Snapshot",
          "type": "string"
        },
        "role": {
          "enum": [
            "benchmark_teacher",
            "label_teacher",
            "fallback_teacher"
          ],
          "title": "Role",
          "type": "string"
        },
        "modality": {
          "enum": [
            "ocr_text",
            "image",
            "image_ocr"
          ],
          "title": "Modality",
          "type": "string"
        },
        "prompt_version": {
          "const": "teacher_vqa_v2",
          "default": "teacher_vqa_v2",
          "title": "Prompt Version",
          "type": "string"
        },
        "image_detail": {
          "default": "high",
          "enum": [
            "high",
            "low"
          ],
          "title": "Image Detail",
          "type": "string"
        },
        "max_output_tokens": {
          "default": 4096,
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "const": "none",
          "default": "none",
          "title": "Reasoning Effort",
          "type": "string"
        },
        "store": {
          "const": false,
          "default": false,
          "title": "Store",
          "type": "boolean"
        }
      },
      "required": [
        "model_snapshot",
        "role",
        "modality"
      ],
      "title": "TeacherProfile",
      "type": "object"
    },
    "TeacherQuery": {
      "additionalProperties": false,
      "properties": {
        "qid": {
          "minLength": 1,
          "title": "Qid",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "qid",
        "question"
      ],
      "title": "TeacherQuery",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Question-only data. No general-purpose metadata or answer field is accepted.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Archive Sha256",
      "type": "string"
    },
    "split_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Split Sha256",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "source_image_id": {
      "minimum": 0,
      "title": "Source Image Id",
      "type": "integer"
    },
    "partition": {
      "enum": [
        "train_fit",
        "dev_select"
      ],
      "title": "Partition",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "integration_pilot",
        "dev_baseline",
        "silver"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "experiment": {
      "enum": [
        "pilot",
        "A1",
        "A2",
        "A3",
        "A5",
        "silver"
      ],
      "title": "Experiment",
      "type": "string"
    },
    "image_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Image Sha256",
      "type": "string"
    },
    "image_path": {
      "minLength": 1,
      "title": "Image Path",
      "type": "string"
    },
    "preprocessing": {
      "minLength": 1,
      "title": "Preprocessing",
      "type": "string"
    },
    "ocr_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ocr Text"
    },
    "ocr_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ocr Sha256"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/TeacherQuery"
      },
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/TeacherProfile"
    }
  },
  "required": [
    "archive_sha256",
    "split_sha256",
    "document_id",
    "source_image_id",
    "partition",
    "purpose",
    "experiment",
    "image_sha256",
    "image_path",
    "preprocessing",
    "questions",
    "profile"
  ],
  "title": "TeacherRequest",
  "type": "object"
}
