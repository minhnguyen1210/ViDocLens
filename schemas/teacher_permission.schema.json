      "title": "External Processing Allowed",
      "type": "boolean"
    },
    "account_terms_reviewed": {
      "default": false,
      "title": "Account Terms Reviewed",
      "type": "boolean"
    },
    "retention_reviewed": {
      "default": false,
      "title": "Retention Reviewed",
      "type": "boolean"
    },
    "batch_files_allowed": {
      "default": false,
      "title": "Batch Files Allowed",
      "type": "boolean"
    },
    "training_export_allowed": {
      "default": false,
      "title": "Training Export Allowed",
      "type": "boolean"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "approved_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "evidence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence"
    },
    "budget_micro_usd": {
      "default": 0,
      "minimum": 0,
      "title": "Budget Micro Usd",
      "type": "integer"
    },
    "price_snapshot_approved": {
      "default": false,
      "title": "Price Snapshot Approved",
      "type": "boolean"
