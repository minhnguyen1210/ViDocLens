{
  "$defs": {
    "AnswerPrediction": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "qid": {
          "minLength": 1,
          "title": "Qid",
          "type": "string"
        },
        "status": {
          "enum": [
            "answered",
            "abstained",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "answer_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Raw"
        }
      },
      "required": [
        "qid",
        "status"
      ],
      "title": "AnswerPrediction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "fixture_only": {
      "title": "Fixture Only",
      "type": "boolean"
    },
    "status": {
      "enum": [
        "completed",
        "timeout",
        "provider_error",
        "invalid_schema"
      ],
      "title": "Status",
      "type": "string"
    },
    "prediction": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerPrediction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raw_response_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Response Sha256"
    },
    "actual_cost_micro_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Cost Micro Usd"
    }
  },
  "required": [
    "request_sha256",
    "fixture_only",
    "status"
  ],
  "title": "FallbackReply",
  "type": "object"
}
