  "required": [
    "source_run",
    "source_manifest_sha256",
    "source_plan_sha256",
    "source_batch_sha256",
    "parsed_batch_sha256",
    "parser_sha256",
    "fixture_only",
    "source_status_counts",
    "parsed_status_counts"
