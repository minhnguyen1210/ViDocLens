{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "quality_pilot",
        "silver_generation"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "generation_allowed": {
      "default": false,
      "title": "Generation Allowed",
      "type": "boolean"
    },
    "data_rights_verified": {
      "default": false,
      "title": "Data Rights Verified",
      "type": "boolean"
    },
    "model_license_verified": {
      "default": false,
      "title": "Model License Verified",
      "type": "boolean"
    },
    "quality_pilot_passed": {
      "default": false,
      "title": "Quality Pilot Passed",
      "type": "boolean"
    },
    "evidence_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "approved_by": {
      "minLength": 1,
      "title": "Approved By",
      "type": "string"
    }
  },
  "required": [
    "plan_sha256",
    "purpose",
    "evidence_sha256",
    "approved_by"
  ],
  "title": "LocalGenerationGrant",
  "type": "object"
}
